{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [ "DOM", "DOM.Iterable", "ES2020" ],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"rootDir": "assets/src"
	},
	"include": [ "assets/src/**/*" ]
}
